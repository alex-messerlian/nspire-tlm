# ChatTLM support files -- a rebranded Ndless loader.
#
# vendor/Ndless is a gitignored clone, so NOTHING EDITED THERE IS TRACKED OR REPRODUCIBLE. The fork
# therefore lives here as brand.py, and this Makefile never leaves vendor's resources modified: it
# copies the pristine sources to $(WORK) and rewrites the copy.
#
# sdk-branding.patch is the exception and has to be, because the strings it changes live in static
# archives that nspire-gcc links from vendor/ndless-sdk/lib. There is no copy to patch: the archive
# itself is the build input. It is applied with --forward so re-running is a no-op.
#
# syscall-addrs.h is generated by tools/ndless/mksyscalls.py, a port of upstream's mkSyscalls.php,
# because that PHP script was the only thing in this build needing a PHP interpreter.
# tools/eval/gate_syscalls.py checks the port against the addresses Ndless actually ships.

TOP     := $(CURDIR)/..
VENDOR  := $(TOP)/vendor/Ndless
SRC     := $(VENDOR)/ndless/src/resources
SDK     := $(VENDOR)/ndless-sdk
WORK    := $(TOP)/build/resources
ADDRS   := $(SDK)/include/syscall-addrs.h
OUT     := $(TOP)/build/chattlm_support.tns

# Rebranded by sdk-branding.patch, and linked into BOTH this and chattlm.tns. Listing them as
# prerequisites is not optional: a rebranded libsyscalls.a once linked into nothing at all, because
# make reported "Nothing to be done" and the binary kept every Ndless string.
SDKLIBS := $(SDK)/lib/libsyscalls.a $(SDK)/lib/libndls.a

export PATH := $(PATH):$(SDK)/bin:$(SDK)/toolchain/install/bin

all: $(OUT)

$(ADDRS): $(TOP)/tools/ndless/mksyscalls.py
	python3 $< $(VENDOR)/ndless/src/tools/MakeSyscalls/idc $@ >/dev/null

# Upstream's inner Makefile has never heard of the archives, so depending on them from $(OUT) is not
# enough -- the inner make still says "up to date". Re-copying WORK is the only dependency it
# respects, and it costs about three seconds for eleven files.
$(WORK)/.patched: brand.py $(SDKLIBS) $(wildcard $(SRC)/*.c $(SRC)/*.cpp $(SRC)/*.h)
	@test "$$(git -C $(VENDOR) rev-parse HEAD)" = "$$(cat VENDOR_COMMIT)" || \
	  { echo "resources: vendor/Ndless is not at the commit these patches were made against"; \
	    echo "  want $$(cat VENDOR_COMMIT)"; echo "  have $$(git -C $(VENDOR) rev-parse HEAD)"; exit 1; }
	rm -rf $(WORK)
	mkdir -p $(WORK)
	cp $(SRC)/*.c $(SRC)/*.cpp $(SRC)/*.h $(SRC)/Makefile $(WORK)/
	python3 $(CURDIR)/brand.py $(WORK)
	touch $@

$(OUT): $(WORK)/.patched $(ADDRS)
	$(MAKE) -C $(WORK) EXE=$(OUT) \
	  ZEHNFLAGS='--name "ChatTLM support" --include-bss --uses-lcd-blit true --version 2022' $(OUT)

# Re-apply the SDK patch and rebuild only the two objects it touches. Idempotent.
sdk:
	cd $(VENDOR) && patch -p1 --batch --forward < $(CURDIR)/sdk-branding.patch || true
	cd $(SDK)/libsyscalls && rm -f stdlib.o stdlib_nspireio.o && \
	  $(MAKE) ../lib/libsyscalls.a ../lib/libsyscalls_nspireio.a
	cd $(SDK)/libndls && rm -f assert_ndless_rev.o && $(MAKE)

clean:
	rm -rf $(WORK) $(OUT)

.PHONY: all clean sdk
