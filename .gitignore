# ---- build products -----------------------------------------------------------------------------
# build/ holds what `make` produces. One test fixture there is tracked.
build/*
!build/tok_reference.json
*.elf
*.tns
*.zehn
*.dis
*.o
*.bak
build/test_*_mut
# host tools compiled next to their sources (tools/eval/Makefile)
tools/eval/evalcli
tools/eval/provcli
tools/eval/shapecli
tools/eval/test_eval
tools/eval/fuzz
tools/eval/golden.txt
tools/nspire-cli/nsp
# paper build outputs; paper/paper.pdf and paper/paper-preprint.pdf are tracked
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/paper-preprint.tex
# the preprint's LaTeX upload and the TMLR supplementary files, rebuilt by tools/paper/
submission/preprint-source.zip
submission/supplementary.zip
submission/supplementary/*.mp4

# ---- data that lives outside git ----------------------------------------------------------------
# the Ndless SDK, llama2.c and libnspire (tools/fetch_vendor.sh); no trailing slash, so a symlink matches too
/vendor
# the OpenStax sources, 5.1 GB (tools/fetch_oer.sh). Never commit this path.
/corpus/raw
# unpacked from corpus/synth_sample.jsonl.gz by `make corpus`
corpus/synth_sample.jsonl
# training streams (train/prepare.py) and checkpoints (release assets, see train/README.md)
train/*.bin
train/*.pt
train/archive_*/
/models
# the original photographs and video of the calculator (see submission/PHOTOS.md)
/media

# ---- environments and local files ---------------------------------------------------------------
/.venv-tok
/.venv-fig
__pycache__/
*.pyc
.DS_Store
.gate_controls.lock
/attic
